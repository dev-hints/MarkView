{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkView",
  "version": "1.0.0",
  "identifier": "com.markview.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkView",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Professional Cross-Platform Markdown Desktop Application",
    "longDescription": "MarkView is a modern, high-performance cross-platform desktop application for reading, browsing, and rendering local Markdown documents with Shiki syntax highlighting, KaTeX math expressions, Mermaid diagrams, and instant search.",
    "copyright": "Copyright © 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
